# Copier ce fichier en backend/.env et remplir les valeurs.
# backend/.env n'est jamais versionné.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=refuges
DB_USER=refuges
DB_PASSWORD=

# ---- Optionnel (valeurs par défaut ci-dessous) ----

# Base utilisée par pytest (vidée à chaque test, jamais la base de développement).
# DB_NAME_TEST=refuges_test

# Adresse du site, pour les liens envoyés par email.
# FRONTEND_URL=http://localhost:5173

# console : les emails sont écrits dans les logs de l'API (lien de confirmation à copier).
# smtp : envoyés à un serveur SMTP, par exemple Mailpit (http://localhost:8025).
# EMAIL_BACKEND=console
# SMTP_HOST=localhost
# SMTP_PORT=1025
# EMAIL_FROM=Refuges <no-reply@refuges.local>

# À passer à true quand le site est servi en HTTPS.
# COOKIE_SECURE=false
